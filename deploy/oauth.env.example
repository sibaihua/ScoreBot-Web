# 复制到 /opt/scorebot/oauth.env，chmod 600
# systemd 通过 EnvironmentFile 读取，密钥不会出现在 ps 输出里
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_AUTHORIZE_URL=https://pan.example.com/authorize
OAUTH_TOKEN_URL=https://pan.example.com/oauth/token
OAUTH_USERINFO_URL=https://pan.example.com/oauth/userinfo
OAUTH_REDIRECT_URI=https://grade.example.com/
OAUTH_SCOPE=openid email profile
