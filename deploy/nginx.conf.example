# 示例：宝塔 / 原生 nginx 站点配置
# 把 grade.example.com 全部替换成你自己的域名后使用
# 前端静态页由 nginx 直接提供，/api/ 与 /sbapi/ 反代到 127.0.0.1:8787
server
{
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name grade.example.com;
    index index.html index.htm;
    root /www/wwwroot/grade.example.com;
    charset utf-8;

    #SSL-START
    ssl_certificate    /www/server/panel/vhost/cert/grade.example.com/fullchain.pem;
    ssl_certificate_key    /www/server/panel/vhost/cert/grade.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+CHACHA20:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    #SSL-END

    #CERT-APPLY-CHECK--START
    # 用于SSL证书申请时的文件验证相关配置 -- 请勿删除
    include /www/server/panel/vhost/nginx/well-known/grade.example.com.conf;
    #CERT-APPLY-CHECK--END

    # 后端命令接口：反代到 ScoreBot-Go web adapter
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }

    # 备用前缀：绕过 CDN 上已缓存的旧 /api/ 响应
    location ^~ /sbapi/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    access_log  /www/wwwlogs/grade.example.com.log;
    error_log  /www/wwwlogs/grade.example.com.error.log;
}
